[Unit]
Description=Claude Code Discord Bridge
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# %h expands to the user's home directory in systemd --user units.
WorkingDirectory=%h/cc-discord-bridge
Environment="DENO_DIR=%h/.deno"
Environment="PATH=%h/.deno/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
EnvironmentFile=%h/cc-discord-bridge/.env
ExecStart=%h/.deno/bin/deno task start
Restart=always
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target